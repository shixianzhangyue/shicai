{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Shicore",
  "version": "0.1.0",
  "identifier": "com.talentvault.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "拾才",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://api.openai.com https://aip.baidubce.com https://dashscope.aliyuncs.com https://token-plan-cn.xiaomimimo.com http://localhost:*",
      "capabilities": [
        {
          "identifier": "default",
          "description": "Default permissions for Shicore",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "dialog:default",
            "fs:default",
            "fs:allow-app-read",
            "fs:allow-app-write",
            "fs:allow-appdata-read",
            "fs:allow-appdata-write",
            "fs:allow-read-dir",
            "fs:allow-write-file",
            { "identifier": "fs:allow-read-file", "allow": [{ "path": "$APPDATA/**" }] },
            "fs:allow-copy-file",
            { "identifier": "fs:allow-remove", "allow": [{ "path": "$APPDATA/**" }] }
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
