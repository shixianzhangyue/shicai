{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TalentVault",
  "version": "0.1.0",
  "identifier": "com.talentvault.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TalentVault",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "description": "Default permissions for TalentVault",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "dialog:default",
            "fs:default",
            "fs:allow-app-read",
            "fs:allow-app-write",
            "fs:allow-appdata-read",
            "fs:allow-appdata-write",
            "fs:allow-read-dir",
            "fs:allow-write-file",
            "fs:allow-read-file",
            "fs:allow-copy-file",
            "fs:allow-remove",
            "shell:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
